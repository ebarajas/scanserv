## ── Printer ──────────────────────────────────────────────
PRINTER_IP="192.168.1.100"
PRINTER_MODEL="MFC-L2717DW"

## ── NAS Mount ────────────────────────────────────────────
## Type: "cifs" for SMB/Samba shares, "nfs" for NFS exports
NAS_TYPE="cifs"
NAS_HOST="192.168.1.50"
## CIFS: share name (e.g. "scans"). NFS: export path (e.g. "/volume1/scans")
NAS_SHARE="scans"
## Credentials (CIFS only — ignored for NFS)
NAS_USER="scanner"
NAS_PASS="changeme"
## Where to mount inside the container
NAS_MOUNT="/mnt/nas/scans"

## ── Scan Defaults ────────────────────────────────────────
## Resolution in DPI (100, 150, 200, 300, 600)
SCAN_RESOLUTION="300"
## Color mode: "Gray", "Black & White", "24bit Color"
SCAN_MODE="Gray"
## Page size in mm (Letter: 215.9 x 279.4, A4: 210 x 297)
SCAN_WIDTH="215.9"
SCAN_HEIGHT="279.4"
## What each printer button does: adf, duplex, flatbed
BUTTON_FILE="adf"
BUTTON_IMAGE="flatbed"
BUTTON_EMAIL="duplex"
BUTTON_OCR="adf"

## ── LXC Container ────────────────────────────────────────
## Set to "auto" to pick the next available ID
CT_ID="auto"
CT_HOSTNAME="scanserv"
CT_MEMORY="512"
CT_DISK="4"
CT_CORES="1"
CT_BRIDGE="vmbr0"
## "dhcp" or a static address like "192.168.1.201/24"
CT_IP="dhcp"
## Gateway (required only for static IP)
CT_GW=""
## Proxmox storage for the container rootfs (e.g. "local-lvm")
CT_STORAGE="local-lvm"
## Proxmox storage that holds ISO/template files (e.g. "local")
CT_TEMPLATE_STORAGE="local"
